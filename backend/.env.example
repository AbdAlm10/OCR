# Default model id: ocr-v3 | warraq | fanar-htr
OCR_DEFAULT_MODEL=ocr-v3

# auto | cuda | cpu | mps
OCR_DEVICE=auto

# Preload default model on API start (false = faster boot)
OCR_PRELOAD=false

OCR_MAX_NEW_TOKENS=512
WARRAQ_MAX_NEW_TOKENS=256
FANAR_HTR_MAX_NEW_TOKENS=160
WARRAQ_BASE=QCRI/Fanar-2-Oryx-IVU

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=25
